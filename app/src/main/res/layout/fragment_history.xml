<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_background"
    android:fitsSystemWindows="true">

    <!-- Background Decoration -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_cyber_grid"
        android:scaleType="centerCrop"
        android:alpha="0.1"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/history_subtitle"
            android:textColor="@color/cyber_primary"
            android:textSize="13sp"
            android:alpha="0.8"
            android:gravity="center" />
    </LinearLayout>

    <!-- Selection Bar (Visible in Selection Mode) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/cyber_surface_variant"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/ll_header">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <TextView
                android:id="@+id/tv_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="3 items selected" />
            <ImageButton
                android:id="@+id/btn_delete_selected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/cyber_malicious"
                android:contentDescription="@string/delete_selected" />
            <ImageButton
                android:id="@+id/btn_close_selection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/white"
                android:contentDescription="@string/close" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Storage Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_storage_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#0DFFFFFF"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cv_selection_bar"
        app:layout_goneMarginTop="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_files_stored"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/cyber_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Files Stored: 15" />
                <TextView
                    android:id="@+id/tv_storage_used"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="24 MB" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_last_scanned_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cyber_neutral"
                android:textSize="10sp"
                tools:text="Last Scan: report_v3.pdf" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_delete_all"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete All Data"
        android:textColor="@color/cyber_malicious"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/search_card"
        app:layout_constraintTop_toBottomOf="@id/cv_storage_info" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btn_delete_all">
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_dashboard"
            android:drawablePadding="16dp"
            android:hint="@string/search_logs_hint"
            android:paddingHorizontal="20dp"
            android:textColor="@color/white"
            android:textColorHint="@color/cyber_neutral"
            android:textSize="14sp"
            android:inputType="text"
            android:importantForAutofill="no" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_card"
        tools:listitem="@layout/item_scan_history" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_card">
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:alpha="0.1"
            android:src="@drawable/ic_history"
            android:contentDescription="@string/empty_logs"
            app:tint="@color/cyber_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/db_ready"
            android:textColor="@color/cyber_neutral"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/populate_logs"
            android:textColor="@color/cyber_neutral"
            android:textSize="12sp"
            android:alpha="0.7" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>